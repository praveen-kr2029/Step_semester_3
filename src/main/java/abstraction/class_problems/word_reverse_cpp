#include <iostream>
#include <string>
#include <algorithm>

using namespace std;

int main() {
    string word;
    cout << "Enter a word: ";
    cin >> word;
    
    string reversed_word = word;
    reverse(reversed_word.begin(), reversed_word.end());
    
    cout << reversed_word << " - ";
    if (word == reversed_word) {
        cout << "palindrome\n";
    } else {
        cout << "not a palindrome\n";
    }
    
    return 0;
}